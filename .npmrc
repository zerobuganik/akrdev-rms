# --- FOR RAILWAY CLOUD DEPLOYMENT ONLY ---
# Disable native builds for packages that require CUPS/desktop libs
# (These are only needed by the Electron POS, not the Cloud API)
allow-builds.'@luckykiet/node-printer'=false
allow-builds.electron=false
allow-builds.electron-winstaller=false
allow-builds.usb=false
allow-builds.node-hid=false
