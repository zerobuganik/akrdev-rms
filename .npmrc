# --- FOR RAILWAY CLOUD DEPLOYMENT ONLY ---
# Disable native builds for packages that require CUPS/desktop libs
# (These are only needed by the Electron POS, not the Cloud API)
allowed-builds[@luckykiet/node-printer]=false
allowed-builds[electron]=false
allowed-builds[electron-winstaller]=false
allowed-builds[usb]=false
allowed-builds[node-hid]=false
