{
  "extends": "@akrdev/tsconfig/tsconfig.node.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "types": ["node"],
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src"]
}
