{
  "name": "@akrdev/captain",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "cap:sync": "cap sync",
    "cap:android": "cap sync android",
    "cap:ios": "cap sync ios",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "cap:run:android": "pnpm build && cap sync android && cap run android",
    "cap:run:ios": "pnpm build && cap sync ios && cap run ios",
    "cap:dev:android": "pnpm build && cap sync android && cap open android",
    "cap:dev:ios": "pnpm build && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@akrdev/shared": "workspace:*",
    "@akrdev/types": "workspace:*",
    "@capacitor-mlkit/barcode-scanning": "8.1.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.4.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/share": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@tanstack/react-query": "^5.0.0",
    "@zxing/browser": "^0.1.5",
    "axios": "^1.0.0",
    "lucide-react": "^1.17.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router": "^7.0.0",
    "react-router-dom": "^7.0.0",
    "socket.io-client": "^4.0.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@akrdev/tsconfig": "workspace:*",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^6.0.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.20.0"
  }
}
