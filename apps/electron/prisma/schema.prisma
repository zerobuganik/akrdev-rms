generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model LocalOrder {
  id            String   @id @default(uuid())
  tableId       String?
  tableName     String?
  customerId    String?
  customerPhone String?
  guestCount    Int      @default(2)
  status        String   @default("New")
  syncStatus    String   @default("Pending")
  subtotal      Float    @default(0)
  taxTotal      Float    @default(0)
  discountTotal Float    @default(0)
  grandTotal    Float    @default(0)
  orderType     String   @default("DineIn")
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items      LocalOrderItem[]
  kots       LocalKOT[]
  settlement LocalSettlement?

  @@map("local_orders")
}

model LocalOrderItem {
  id            String  @id @default(uuid())
  orderId       String
  itemId        String
  itemName      String
  variationId   String?
  variationName String?
  kotId         String?
  quantity      Int     @default(1)
  unitPrice     Float
  lineTotal     Float
  status        String  @default("New")
  note          String?

  order LocalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kot   LocalKOT?  @relation(fields: [kotId], references: [id])

  @@map("local_order_items")
}

model LocalKOT {
  id        String   @id @default(uuid())
  orderId   String
  kotNumber Int
  sentAt    DateTime @default(now())
  sentBy    String

  order LocalOrder      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items LocalOrderItem[]

  @@map("local_kots")
}

model LocalSettlement {
  id            String   @id @default(uuid())
  orderId       String   @unique
  subtotal      Float
  taxTotal      Float
  discountTotal Float
  grandTotal    Float
  cashPaid      Float    @default(0)
  cardPaid      Float    @default(0)
  upiPaid       Float    @default(0)
  discountType  String?
  discountValue Float?
  discountReason String?
  changeGiven   Float    @default(0)
  settledAt     DateTime @default(now())

  order LocalOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("local_settlements")
}

model SyncQueue {
  id         String   @id @default(uuid())
  action     String
  payload    String
  status     String   @default("Pending")
  retryCount Int      @default(0)
  retryAt    DateTime?
  error      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("sync_queue")
}

model SyncState {
  id             String   @id @default("singleton")
  lastSyncAt     DateTime?
  pendingCount   Int      @default(0)
  syncInProgress Boolean  @default(false)
  cloudAvailable Boolean  @default(true)
  backoffMs      Int      @default(1000)
  updatedAt      DateTime @updatedAt

  @@map("sync_state")
}

model PrinterConfig {
  id            String   @id @default(uuid())
  name          String
  displayName   String
  type          String
  connection    String
  address       String?
  vendorId      Int?
  productId     Int?
  paperWidth    Int      @default(80)
  isDefault     Boolean  @default(false)
  isActive      Boolean  @default(true)
  isKitchen     Boolean  @default(false)
  isBilling     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  printHistory PrintHistory[]

  @@map("printer_configs")
}

model PrintHistory {
  id         String   @id @default(uuid())
  printerId  String
  printType  String
  orderId    String?
  tableName  String?
  status     String   @default("Pending")
  retryCount Int      @default(0)
  error      String?
  createdAt  DateTime @default(now())

  printer PrinterConfig @relation(fields: [printerId], references: [id], onDelete: Cascade)

  @@map("print_history")
}

model LocalCredential {
  id           String   @id @default(uuid())
  phone        String   @unique
  passwordHash String
  pinHash      String?
  name         String   @default("Admin")
  role         String   @default("Admin")
  imageUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("local_credentials")
}

model CachedTable {
  id        String  @id
  name      String
  areaId    String?
  areaName  String?
  capacity  Int     @default(4)
  status    String  @default("Available")

  @@map("cached_tables")
}

model CachedCategory {
  id          String @id
  name        String
  displayOrder Int   @default(0)
  imageUrl    String?
  kitchenId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("cached_categories")
}

model CachedArea {
  id   String @id
  name String
  createdAt DateTime @default(now())

  @@map("cached_areas")
}

model CachedItem {
  id          String @id
  name        String
  basePrice   Float
  inStock     Boolean @default(true)
  categoryId  String?
  categoryName String?
  variations  String @default("[]")
  imageUrl    String?

  @@map("cached_items")
}

model CachedSetting {
  id    String @id @default("default")
  data  String

  @@map("cached_settings")
}
