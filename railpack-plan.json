{
  "build": {
    "steps": [
      {
        "name": "install",
        "cmds": [
          "corepack enable",
          "corepack prepare pnpm@11.5.0 --activate",
          "pnpm install --frozen-lockfile --filter @akrdev/api..."
        ]
      },
      {
        "name": "build",
        "cmds": [
          "pnpm --filter @akrdev/api build:full"
        ]
      }
    ],
    "outputs": [
      "apps/api/dist",
      "node_modules"
    ]
  },
  "start": {
    "cmd": "cd apps/api && pnpm --filter @akrdev/api start"
  }
}
