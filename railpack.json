{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "env": {
        "COREPACK_ENABLE_STRICT": "0",
        "ELECTRON_REBUILD_SKIP": "1"
      },
      "commands": [
        "corepack enable",
        "corepack prepare pnpm@11.5.0 --activate",
        "pnpm install --frozen-lockfile --ignore-scripts",
        "cd apps/api && pnpm rebuild argon2 @prisma/engines @prisma/client esbuild msw"
      ]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": [
        "pnpm --filter @akrdev/types --filter @akrdev/shared --filter @akrdev/schemas build",
        "cd apps/api && npx prisma generate && tsc"
      ]
    }
  },
  "deploy": {
    "startCommand": "cd apps/api && pnpm --filter @akrdev/api start"
  }
}
