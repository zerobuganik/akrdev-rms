{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "env": {
        "COREPACK_ENABLE_STRICT": "0",
        "PNPM_HOME": "/tmp/pnpm_home"
      },
      "commands": [
        "corepack enable",
        "corepack prepare pnpm@11.5.0 --activate",
        "pnpm config set allow-builds.'@luckykiet/node-printer' false",
        "pnpm config set allow-builds.electron false",
        "pnpm config set allow-builds.electron-winstaller false",
        "pnpm config set allow-builds.usb false",
        "pnpm config set allow-builds.node-hid false",
        "pnpm install --frozen-lockfile"
      ]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": [
        "pnpm --filter @akrdev/types --filter @akrdev/shared --filter @akrdev/schemas build",
        "cd apps/api && npx prisma generate && tsc"
      ]
    }
  },
  "deploy": {
    "startCommand": "cd apps/api && pnpm --filter @akrdev/api start"
  }
}
