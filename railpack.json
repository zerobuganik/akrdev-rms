{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": [
        "corepack enable",
        "corepack prepare pnpm@11.5.0 --activate",
        "pnpm install --frozen-lockfile"
      ]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": [
        "pnpm --filter @akrdev/types --filter @akrdev/shared --filter @akrdev/schemas build",
        "cd apps/api && npx prisma generate && tsc"
      ]
    }
  },
  "deploy": {
    "startCommand": "cd apps/api && pnpm --filter @akrdev/api start"
  }
}
